<Window x:Class="OmsiLaunch.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmsiLaunch"
        Width="920"
        Height="690"
        MinWidth="780"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="OmsiLaunch" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Inicie e gerencie uma sessão do OMSI 2 sem precisar montar comandos manualmente."
                       Margin="0,4,0,0" Opacity="0.72"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="16" BorderThickness="1" CornerRadius="8" BorderBrush="#33000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Executável do OMSI"/>
                <TextBox x:Name="ExecutablePathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseExecutableButton" Grid.Row="0" Grid.Column="2" Content="Procurar..." Click="BrowseExecutable_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Modo de abertura"/>
                <ComboBox x:Name="LaunchModeComboBox" Grid.Row="2" Grid.Column="1" SelectedIndex="0"
                          SelectionChanged="LaunchMode_SelectionChanged">
                    <ComboBoxItem Content="Novo mapa"/>
                    <ComboBoxItem Content="Situação salva"/>
                </ComboBox>
                <Button x:Name="RefreshContentButton" Grid.Row="2" Grid.Column="2" Content="Atualizar" Click="RefreshContent_Click"/>

                <TextBlock x:Name="ContentLabel" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Mapa"/>
                <ComboBox x:Name="ContentComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                          DisplayMemberPath="Display"
                          SelectionChanged="Content_SelectionChanged"/>

                <TextBlock x:Name="EntrypointLabel" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Ponto de entrada"/>
                <ComboBox x:Name="EntrypointComboBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                          DisplayMemberPath="Display"/>

                <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <CheckBox x:Name="ManagedSplashCheckBox" Content="Splash do OmsiLaunch" IsChecked="True" Margin="0,0,22,0"/>
                    <CheckBox x:Name="DisableInternetTexturesCheckBox" Content="Desativar texturas da internet"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ValidateButton" Grid.Column="0" Content="Validar" Click="Validate_Click"/>
            <Button x:Name="LaunchButton" Grid.Column="1" Content="Iniciar OMSI" Click="Launch_Click"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="Parar sessão" Click="Stop_Click" IsEnabled="False"/>
            <Button x:Name="InstallPluginButton" Grid.Column="3" Content="Instalar plugin" Click="InstallPlugin_Click"/>
            <Button x:Name="RecoveryButton" Grid.Column="4" Content="Recuperar arquivos" Click="Recovery_Click" IsEnabled="False"/>

            <Border Grid.Column="6" Padding="12,8" CornerRadius="6" BorderThickness="1" BorderBrush="#33000000">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="Status: " />
                    <TextBlock x:Name="StatusTextBlock" Text="Pronto"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="6" Padding="14" BorderThickness="1" CornerRadius="8" BorderBrush="#33000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Diagnóstico e eventos" FontWeight="SemiBold"/>
                <TextBox x:Name="LogTextBox" Grid.Row="2" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>
    </Grid>
</Window>
