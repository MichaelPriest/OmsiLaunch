<Window x:Class="OmsiLaunch.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmsiLaunch"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OmsiLaunch" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Hub de sessão, conteúdo, plugins e integração para OMSI 2."
                           Margin="0,3,0,0" Opacity="0.7"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="14,9" CornerRadius="7" BorderThickness="1" BorderBrush="#33000000"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Pronto"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Executável do OMSI" VerticalAlignment="Center"/>
                <TextBox x:Name="ExecutablePathTextBox" Grid.Column="1" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseExecutableButton" Grid.Column="2" Content="Procurar..." Click="BrowseExecutable_Click"/>
                <Button x:Name="RefreshContentButton" Grid.Column="3" Content="Atualizar tudo" Click="RefreshContent_Click"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="4">
            <TabItem x:Name="PlayTab" Header="Jogar">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Iniciar sessão" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Modo de abertura" VerticalAlignment="Center"/>
                                <ComboBox x:Name="LaunchModeComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                          SelectedIndex="0" SelectionChanged="LaunchMode_SelectionChanged">
                                    <ComboBoxItem Content="Novo mapa"/>
                                    <ComboBoxItem Content="Situação salva"/>
                                </ComboBox>

                                <TextBlock x:Name="ContentLabel" Grid.Row="2" Grid.Column="0" Text="Mapa" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ContentComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                          DisplayMemberPath="Display" SelectionChanged="Content_SelectionChanged"/>

                                <TextBlock x:Name="EntrypointLabel" Grid.Row="4" Grid.Column="0" Text="Ponto de entrada" VerticalAlignment="Center"/>
                                <ComboBox x:Name="EntrypointComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                          DisplayMemberPath="Display"/>

                                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <CheckBox x:Name="ManagedSplashCheckBox" Content="Splash do OmsiLaunch" IsChecked="True" Margin="0,0,22,0"/>
                                    <CheckBox x:Name="DisableInternetTexturesCheckBox" Content="Desativar texturas da internet"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="ValidateButton" Content="Validar" Click="Validate_Click"/>
                            <Button x:Name="LaunchButton" Content="Iniciar OMSI" Click="Launch_Click"/>
                            <Button x:Name="StopButton" Content="Parar sessão" Click="Stop_Click" IsEnabled="False"/>
                            <Button x:Name="RecoveryButton" Content="Recuperar arquivos" Click="Recovery_Click" IsEnabled="False"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Resumo da instalação" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="InstallationSummaryTextBlock" Text="Selecione uma instalação do OMSI." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Mapas">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mapas instalados" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="MapsCountTextBlock" Text="0 mapas" Opacity="0.7"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Duplo clique para usar no lançamento" VerticalAlignment="Bottom" Opacity="0.65"/>
                    </Grid>
                    <ListBox x:Name="LibraryMapsListBox" Grid.Row="2" DisplayMemberPath="Display"
                             MouseDoubleClick="LibraryMap_DoubleClick"/>
                </Grid>
            </TabItem>

            <TabItem Header="Ônibus">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Veículos instalados" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="VehiclesCountTextBlock" Text="0 veículos" Opacity="0.7"/>
                    </StackPanel>
                    <ListBox x:Name="VehiclesListBox" Grid.Row="2" Grid.Column="0" DisplayMemberPath="Display"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HOFs" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="HofsCountTextBlock" Text="0 HOFs" Opacity="0.7"/>
                    </StackPanel>
                    <ListBox x:Name="HofsListBox" Grid.Row="2" Grid.Column="2" DisplayMemberPath="Display"/>
                </Grid>
            </TabItem>

            <TabItem Header="Sessão">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sessão" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SessionIdTextBlock" Grid.Row="0" Grid.Column="1" Text="Nenhuma"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Estado" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SessionStateTextBlock" Grid.Row="0" Grid.Column="3" Text="Inativa"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Plugin" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SessionPluginTextBlock" Grid.Row="2" Grid.Column="1" Text="Não conectado"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Runtime" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SessionRuntimeTextBlock" Grid.Row="2" Grid.Column="3" Text="Aguardando"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Eventos da sessão">
                            <ListBox x:Name="SessionEventsListBox"/>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Diagnósticos da sessão">
                            <ListBox x:Name="SessionDiagnosticsListBox"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Plugins">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="InstallPluginButton" Content="Instalar / atualizar OmsiLaunch" Click="InstallPlugin_Click"/>
                        <Button Content="Atualizar inventário" Click="RefreshPluginInventory_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Plugin OmsiLaunch" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PluginStatusTextBlock" Grid.Row="0" Grid.Column="1" Text="Não verificado"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET x86 privado" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PrivateRuntimeStatusTextBlock" Grid.Row="2" Grid.Column="1" Text="Não verificado"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Addons detectados" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AddonsCountTextBlock" Grid.Row="4" Grid.Column="1" Text="0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Arquivos OmsiLaunch em plugins">
                            <ListBox x:Name="PluginFilesListBox"/>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Addons / diretórios detectados">
                            <ListBox x:Name="AddonsListBox" DisplayMemberPath="Display"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnóstico">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Diagnóstico e eventos" Style="{StaticResource SectionTitle}" Margin="0,0,20,0"/>
                        <Button Content="Limpar" Click="ClearLog_Click"/>
                    </StackPanel>
                    <TextBox x:Name="LogTextBox" Grid.Row="2" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem Header="Integrações">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Integrações" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="OMSI NavBR Multiplayer" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Integração recomendada por processo/local control: iniciar sessão, acompanhar runtime, obter mapa, ônibus, timetable e veículos remotos sem duplicar a lógica nativa do OmsiLaunch."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="OMSI Map Studio" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Integração recomendada pela API IOmsiLaunch: abrir OMSI diretamente no mapa/ponto de entrada escolhido e usar o runtime como ponte de teste entre editor e simulador."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Contrato público" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="As integrações devem consumir OmsiLaunch.Api ou o canal de controle local. Endereços nativos, patches e transações permanecem encapsulados no OmsiLaunch."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
